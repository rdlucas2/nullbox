# Copy to .env (gitignored) and fill in. Only needed for real runs; tests use fakes.

# Host port and interface the UI is published on.
NULLBOX_PORT=8480
NULLBOX_BIND=0.0.0.0

# Admin login for the UI and /hangfire (M0-03).
ADMIN_PASSWORD=

# TypeSafe Jev API key (https://console.typesafe.ai/keys). Issues #19/#20 call this TYPESAFE_API_KEY.
JEV_API_KEY=

# Optional: only if not using emailBlaster's credentials.json in ./data/google/ (see PLAN.md auth note).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
