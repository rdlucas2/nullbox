# Copy to deploy/.env (gitignored) and fill in.

# Required: the server's LAN IP, so the UI is published on that interface only (find it with `ip -4 addr`).
# Use 127.0.0.1 if you only reach nullbox through Tailscale Serve on the same box.
NULLBOX_BIND=
NULLBOX_PORT=8480

# Admin login for the UI and /hangfire.
ADMIN_PASSWORD=

# TypeSafe Jev API key (https://console.typesafe.ai/keys). Either name works.
JEV_API_KEY=

# Owner of ./data and ./backups on the host. Leave unset for the image's user (1654), or set to your
# `id -u` / `id -g` so you can read them without sudo.
NULLBOX_UID=
NULLBOX_GID=

# Nightly snapshots to keep in ./backups.
NULLBOX_BACKUP_KEEP=14

# Memory cap for the container.
NULLBOX_MEM_LIMIT=512m

# Pull a published image instead of building from source (leave unset to build).
NULLBOX_IMAGE=

# Optional: only if not using emailBlaster's credentials.json in ./data/google/.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App-wide delete lock (#35). Leave unset (false) so nothing is ever moved to Trash or deleted; rules archive
# instead. Set to true only once you trust the rules that are switched to Delete.
# Nullbox__Gmail__AllowDelete=true

# Log format: simple (default) or json (one object per line). Bodies, subjects and snippets are never logged.
NULLBOX_LOG_FORMAT=simple
