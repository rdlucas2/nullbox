<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Nullbox.Web</RootNamespace>
    <!-- The SDK only adds blazor.web.js when it sees .razor files at restore time; the Docker build restores from
         the csproj alone, so say it explicitly. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nullbox.Core\Nullbox.Core.csproj" />
    <ProjectReference Include="..\Nullbox.Gmail\Nullbox.Gmail.csproj" />
    <ProjectReference Include="..\Nullbox.Jev\Nullbox.Jev.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageReference Include="Hangfire.Storage.SQLite" Version="0.4.3" />
    <PackageReference Include="MudBlazor" Version="9.14.0" />
    <!-- Transitive pins: patched versions of packages Hangfire pulls in with known advisories. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

</Project>
