@inherits LayoutComponentBase

<MudThemeProvider @ref="_theme" @bind-IsDarkMode="_dark" Theme="NullboxTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Toggle navigation" />
        <MudText Typo="Typo.h6" Class="ml-2">nullbox</MudText>
        <MudSpacer />
        <MudTooltip Text="@(_dark ? "Light mode" : "Dark mode")">
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleDark" aria-label="Toggle dark mode" />
        </MudTooltip>
        <form method="post" action="/logout" class="d-inline">
            <AntiforgeryToken />
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
        </form>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawer" ClipMode="DrawerClipMode.Always" Elevation="1" Breakpoint="Breakpoint.Md">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider? _theme;
    private bool _dark;
    private bool _drawer = true;
    private bool _followSystem = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _followSystem && _theme is not null)
        {
            _dark = await _theme.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private void ToggleDrawer() => _drawer = !_drawer;

    private void ToggleDark()
    {
        _followSystem = false;
        _dark = !_dark;
    }
}
